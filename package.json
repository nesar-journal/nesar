{
  "name": "nesar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "pnpm run disable-telemetry && pnpm run compile && next build",
    "compile": "pnpm run compile-data && pnpm run compile-index",
    "compile-data": "tsx ./src/compile-data.ts",
    "compile-index": "tsx ./src/compile-index.ts",
    "dev": "pnpm run compile && next dev",
    "disable-telemetry": "next telemetry disable",
    "lint-fix": "next lint --fix",
    "lint": "next lint",
    "prepare": "husky",
    "start": "next start",
    "type-check": "tsc"
  },
  "dependencies": {
    "@indic-transliteration/sanscript": "^1.3.3",
    "@xmldom/xmldom": "^0.9.12",
    "classnames": "^2.5.1",
    "fuzzysort": "^3.1.0",
    "htmlparser2": "^9.1.0",
    "js-yaml": "^5.4.2",
    "next": "15.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.33.5",
    "url-slug": "^4.0.1",
    "xpath": "^0.0.34",
    "yaml": "^2.9.1",
    "yaml-loader": "^0.8.1"
  },
  "devDependencies": {
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.16.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.4",
    "husky": "^9.1.7",
    "sass": "1.55.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
